<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MY PERSONAL CV"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:gravity="center"
            android:padding="12dp" />

        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="146dp"
            android:layout_height="143dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Owen Muriuki profile photo"
            android:scaleType="centerCrop"
            android:src="@drawable/owen" />

        <TextView
            android:id="@+id/txtName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MURIUKI OWEN"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ICT TECHNICIAN"
            android:textSize="16sp"
            android:textColor="#475569"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ABOUT ME"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I am Muriuki Owen, an ICT technician passionate about technology, computer systems and software development. I enjoy learning new skills and solving problems using technology."
            android:textSize="16sp"
            android:textColor="#334155"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MY DETAILS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Course: ICT Technician Level 6\nInstitution: The Maasai National Polytechnic\nInterests: Programming, computers and technology\nCareer Goal: To become a skilled ICT professional"
            android:textSize="16sp"
            android:textColor="#334155"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:textColor="#334155"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIEW MY SKILLS"
            android:textAllCaps="false"
            android:layout_marginTop="16dp"
            android:onClick="Opening"/>

    </LinearLayout>
</ScrollView>